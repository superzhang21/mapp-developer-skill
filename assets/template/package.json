{
  "name": "mini-app-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun run typecheck && bun --bun vite build && bun run scripts/package.ts",
    "build:debug": "MINI_APP_DEBUG=1 bun run build",
    "typecheck": "tsc -p tsconfig.json",
    "validate": "node ../scripts/validate.mjs ."
  },
  "dependencies": {
    "@discourse-mini-app/sdk": "file:../../sdk"
  },
  "devDependencies": {
    "vite": "8.3.5",
    "typescript": "5.9.3",
    "@types/node": "24.10.0",
    "@types/bun": "1.4.3"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
